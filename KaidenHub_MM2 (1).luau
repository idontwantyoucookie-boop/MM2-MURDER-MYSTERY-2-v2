		return false
	end
	local now2 = os.clock()
	local n2 = -math.huge
	local v8 = nil

	for k in pairs(Hub.CoinFarm.coins) do
		local flag7 = Hub.CoinFarm.IsCoinAvailable(k)

		if flag7 then
			flag7 = (Hub.CoinFarm.retryUntil[k] or 0) <= now2
		end

		if flag7 then
			local magnitude = (k.Position - arg2.Position).Magnitude

			if n2 < magnitude then
